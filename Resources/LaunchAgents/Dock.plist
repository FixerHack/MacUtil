<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- UniMacHub's Dock, registered by the app through SMAppService.agent. launchd starts it
	     at login and again if it stops other than by quitting cleanly (it quits cleanly when
	     the Dock is turned off). Installed as Contents/Library/LaunchAgents/__BUNDLE_ID__.Dock.plist. -->
	<key>Label</key>
	<string>__BUNDLE_ID__.Dock</string>
	<key>BundleProgram</key>
	<string>Contents/Library/LoginItems/UniMacHub Dock.app/Contents/MacOS/UniMacHub Dock</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>__BUNDLE_ID__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
